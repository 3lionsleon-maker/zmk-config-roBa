#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        eisuu {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <12 13>;
        };

        kana {
            bindings = <&kp LA(GRAVE)>;
            key-positions = <18 19>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp SEMICOLON   &kp C         &kp U         &kp Y           &kp P                                         &kp V        &kp D  &kp H  &kp G  &kp J
&kp A           &kp O         &kp E         &kp I           &kp PERIOD  &kp LS(LG(S))      &kp MINUS      &kp K        &kp T  &kp N  &kp S  &lt 5 R
&kp Q           &kp X         &kp COMMA     &kp Z           &kp DEL     &kp SLASH          &kp PLUS       &kp F        &kp W  &kp M  &kp B  &mt LCTRL L
&kp LEFT_SHIFT  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp SPACE   &lt 1 TAB          &kp BACKSPACE  &lt 2 ENTER                       &kp SLASH
            >;
        };

        NUM {
            bindings = <
&trans  &trans          &trans          &trans           &trans                         &kp PLUS   &kp N7  &kp N8  &kp N9  &trans
&kp AT  &kp LEFT_ARROW  &kp UP_ARROW    &kp RIGHT_ARROW  &kp SLASH  &kp F6      &trans  &kp MINUS  &kp N4  &kp N5  &kp N6  &trans
&kp F7  &kp F8          &kp DOWN_ARROW  &trans           &trans     &trans      &trans  &kp N0     &kp N1  &kp N2  &kp N3  &trans
&trans  &trans          &trans          &trans           &trans     &trans      &trans  &trans                             &trans
            >;
        };

        symbol {
            bindings = <
&kp LS(N1)     &kp LS(FSLH)  &kp LS(N6)     &kp LS(INT3)  &kp LS(EQUAL)  &trans  &kp LS(RBKT)  &kp LS(N2)    &kp LS(NUHS)  &kp LBKT
&kp LS(SEMI)   &kp MINUS     &kp LS(SQT)    &kp FSLH      &kp LS(N5)     &trans  &trans        &trans        &kp LS(N8)    &kp LS(N7)  &kp LS(N9)    &kp LS(N3)
&kp EQUAL      &kp LS(COMMA) &kp LS(MINUS)  &kp LS(DOT)   &kp LS(N4)     &trans  &trans        &trans        &kp RBKT      &kp LS(INT1) &kp NUHS      &kp INT1
&trans         &trans        &trans          &trans        &trans          &trans  &trans        &trans        &trans
            >;
        };

        Shortcuts {
            bindings = <
&trans         &kp E      &kp LC(S)      &kp LS(LC(C))  &kp LS(LC(M))                      &trans     &kp LS(ENTER)  &trans     &kp LS(P)  &trans
&kp LS(LA(S))  &kp LC(E)  &kp LC(Z)      &kp LC(C)      &kp R          &trans      &trans  &kp L      &kp LC(V)      &kp LC(Y)  &kp P      &trans
&trans         &kp LS(E)  &kp LS(LC(S))  &kp C          &kp LC(R)      &trans      &trans  &kp LS(P)  &kp P          &trans     &kp LC(P)  &trans
&trans         &trans     &trans         &trans         &trans         &trans      &trans  &trans                                          &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans     &trans     &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &kp LC(X)  &kp LC(C)  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans     &kp LC(V)  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans     &trans     &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
